# Copy to .env.deploy (git-ignored). Used by scripts/run_v4_suite.sh.
# Hugging Face token: required for the gated Llama-3.x and Gemma-2 models.
HF_TOKEN=
# Remote GPU host for --remote / --pull (optional).
REMOTE_HOST=user@gpu-host
SSH_PORT=22
SSH_KEY=~/.ssh/id_ed25519
SSH_EXTRA_OPTS="-o ServerAliveInterval=30 -o ServerAliveCountMax=3"
REMOTE_DIR=char-store-probing
